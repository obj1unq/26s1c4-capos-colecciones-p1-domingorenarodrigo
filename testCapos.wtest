import capos.*
import artefacto.*
import mochila.*
import castillo.*
import historial.*

describe "1.1 - Rolando" {
  method llenarMochila() {
    mochila.guardarArtefacto(espadaDelDestino)
    mochila.guardarArtefacto(libroDeHechizos)
  }
  
  method llenarMochilaDeRolando() {
    rolando.encontrar(espadaDelDestino)
    rolando.encontrar(libroDeHechizos)
  }
  
  test "Al inicio, la mochila tiene capacidad para guardar hasta 2 artefactos" {
    assert.equals(2, mochila.capacidad())
  }
  
  test "La mochila inicia sin artefactos" {
    assert.equals(0, mochila.artefactos().size())
  }
  
  test "La mochila inicia con capacidad para guardar artefactos" {
    assert.that(mochila.tieneCapacidad())
  }
  
  test "Se incrementa la capacidad de la mochila" {
    const inicial = mochila.capacidad()
    const extra = 3
    
    mochila.incrementarCapacidad(extra)
    
    assert.equals(inicial + extra, mochila.capacidad())
  }
  
  test "Se conocen los artefactos que hay en la mochila" {
    self.llenarMochila()
    
    assert.equals(#{espadaDelDestino, libroDeHechizos}, mochila.artefactos())
  }
  
  test "Con capacidad, la mochila guarda un artefacto" {
    mochila.guardarArtefacto(espadaDelDestino)
    
    assert.that(mochila.artefactos().contains(espadaDelDestino))
  }
  
  test "Sin capacidad, la mochila guarda un artefacto y hay error" {
    self.llenarMochila()
    
    assert.throwsExceptionWithMessage(
      "La mochila no tiene capacidad para un nuevo artefacto",
      { mochila.guardarArtefacto(collarDivino) }
    )
  }
  
  test "Se conocen los artefactos que hay en la mochila de Rolando" {
    self.llenarMochilaDeRolando()
    
    assert.equals(
      #{espadaDelDestino, libroDeHechizos},
      rolando.artefactosEnMochila()
    )
  }
  
  test "Con capacidad en la mochila, Rolando encuentra un artefacto y lo recolecta" {
    rolando.encontrar(espadaDelDestino)
    
    assert.that(rolando.artefactosEnMochila().contains(espadaDelDestino))
  }
  
  test "Con la mochila llena, Rolando encuentra un artefacto y no lo recolecta" {
    self.llenarMochilaDeRolando()
    
    rolando.encontrar(collarDivino)
    
    assert.notThat(rolando.artefactosEnMochila().contains(collarDivino))
  }
  
  test "Con la mochila llena, Rolando recolecta un artefacto y hay error" {
    self.llenarMochilaDeRolando()
    
    assert.throwsExceptionWithMessage(
      "La mochila no tiene capacidad para un nuevo artefacto",
      { rolando.recolectar(collarDivino) }
    )
  }
}

describe "1.2 - Castillo de piedra" {
  test "El Castillo de piedra inicia sin artefactos" {
    assert.equals(0, castilloDePiedra.artefactos().size())
  }
  
  test "Se conocen los artefactos que hay en el Castillo de piedra" {
    castilloDePiedra.guardarArtefacto(espadaDelDestino)
    castilloDePiedra.guardarArtefacto(libroDeHechizos)
    
    assert.equals(
      #{espadaDelDestino, libroDeHechizos},
      castilloDePiedra.artefactos()
    )
  }
  
  test "El castillo de piedra guarda un artefacto" {
    castilloDePiedra.guardarArtefacto(espadaDelDestino)
    
    assert.that(castilloDePiedra.artefactos().contains(espadaDelDestino))
  }
  
  test "El castillo de piedra guarda varios artefactos" {
    castilloDePiedra.guardarArtefactos(#{espadaDelDestino, libroDeHechizos})
    
    assert.equals(
      #{espadaDelDestino, libroDeHechizos},
      castilloDePiedra.artefactos()
    )
  }
  
  test "Se conocen los artefactos que hay en el hogar de Rolando" {
    rolando.encontrar(espadaDelDestino)
    rolando.encontrar(libroDeHechizos)
    rolando.llegarAlHogar()
    
    assert.equals(
      #{espadaDelDestino, libroDeHechizos},
      rolando.artefactosEnHogar()
    )
  }
  
  test "Rolando llega al hogar con un artefacto y lo guarda en él" {
    rolando.encontrar(espadaDelDestino)
    
    rolando.llegarAlHogar()
    
    assert.that(rolando.artefactosEnHogar().contains(espadaDelDestino))
  }
  
  test "Rolando llega al hogar con un artefacto y vacía la mochila" {
    rolando.encontrar(espadaDelDestino)
    
    rolando.llegarAlHogar()
    
    assert.that(rolando.artefactosEnMochila().isEmpty())
  }
}

describe "1.3 - Saber qué artefactos tiene Rolando" {
  test "Se conocen los artefactos que posee" {
    rolando.encontrar(espadaDelDestino)
    rolando.encontrar(libroDeHechizos)
    rolando.llegarAlHogar()
    rolando.encontrar(collarDivino)
    
    assert.equals(
      #{espadaDelDestino, libroDeHechizos, collarDivino},
      rolando.posesiones()
    )
  }
  
  test "Se sabe si posee un artefacto" {
    rolando.encontrar(espadaDelDestino)
    
    assert.that(rolando.posee(espadaDelDestino))
  }
  
  test "Se sabe si no posee un artefacto" {
    assert.notThat(rolando.posee(espadaDelDestino))
  }
}

describe "1.4 - Saber la historia de los encuentros con los artefactos" {
  test "El historial inicia sin artefactos" {
    assert.equals(0, historial.artefactos().size())
  }
  
  test "Se conocen los artefactos que hay en el historial" {
    historial.registrar(espadaDelDestino)
    historial.registrar(libroDeHechizos)
    
    assert.equals([espadaDelDestino, libroDeHechizos], historial.artefactos())
  }
  
  test "Se registra un artefacto en el historial" {
    historial.registrar(libroDeHechizos)
    
    assert.that(historial.artefactos().contains(libroDeHechizos))
  }
  
  test "Se conocen los artefactos que hay en el historial de encuentros de Rolando" {
    rolando.encontrar(espadaDelDestino)
    rolando.encontrar(libroDeHechizos)
    rolando.encontrar(collarDivino)
    rolando.llegarAlHogar()
    rolando.encontrar(armaduraDeAceroValyrio)
    rolando.encontrar(collarDivino)
    
    assert.equals(
      [
        espadaDelDestino,
        libroDeHechizos,
        collarDivino,
        armaduraDeAceroValyrio,
        collarDivino
      ],
      rolando.artefactosEnHistorial()
    )
  }
  
  test "Se encuentra un artefacto y se registra en el historial de encuentros de Rolando" {
    rolando.encontrar(espadaDelDestino)
    
    assert.that(rolando.artefactosEnHistorial().contains(espadaDelDestino))
  }
}